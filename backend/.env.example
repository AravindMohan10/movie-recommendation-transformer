# CineAI - Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.

# Required for JWT auth (generate a secure random string)
SECRET_KEY=your-secret-key-at-least-32-chars

# Optional: PostgreSQL (defaults to SQLite if not set)
# USE_POSTGRES=true
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_DB=movie_recommendation
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Required for CF+RAG (preference extraction)
GROQ_API_KEY=

# Required for password reset emails (Resend free tier: 3000/month)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@resend.dev

# Production: set to your frontend URL for password reset links
FRONTEND_URL=http://localhost:5173

# Required for movie search + share page (get free key at themoviedb.org)
TMDB_API_KEY=

# Optional: Redis for caching (in-memory fallback if not set)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Production: set to production to disable debug routes, use prod cache TTL, and require SECRET_KEY
ENV=production

# Optional: CORS origins (comma-separated). In production set to your frontend URL(s).
ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-domain.com
